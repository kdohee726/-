import assert from 'node:assert/strict';
import {whiskies} from '../dist/data.js';
import {recommend,fitsBudget,WEIGHTS} from '../dist/recommend.js';
assert.ok(whiskies.length>=12);assert.equal(new Set(whiskies.map(w=>w.id)).size,whiskies.length);
for(const w of whiskies){assert.equal(w.flavors.length,5);assert.ok(w.flavors.every(v=>v>=0&&v<=5));assert.ok(w.price[0]<=w.price[1]);assert.ok(w.source.startsWith('https://'));}
assert.equal(Object.values(WEIGHTS).reduce((a,b)=>a+b),1);
const base={experience:0,budget:1,serving:'neat',flavors:[3,5,0,1,2]};
const fruity=recommend(base),smoky=recommend({...base,experience:2,budget:2,flavors:[2,1,5,3,3]});
assert.notEqual(fruity.items[0].id,smoky.items[0].id);assert.equal(smoky.items[0].id,'laph');
for(let b=0;b<4;b++){const r=recommend({...base,budget:b});assert.equal(r.items.length,3);assert.equal(new Set(r.items.map(w=>w.id)).size,3);assert.ok(r.items.every(w=>w.score>=0&&w.score<=100));const count=whiskies.filter(w=>fitsBudget(w,b)).length;assert.equal(r.items.filter(w=>w.inBudget).length,Math.min(3,count));}
assert.ok(recommend({...base,budget:3}).notice.includes('2종'));
assert.ok(recommend(base,whiskies.filter(w=>!fitsBudget(w,1))).notice.includes('없어'));
assert.deepEqual(recommend(base),recommend(base));
assert.throws(()=>recommend({...base,flavors:[6,0,0,0,0]}));
const target=whiskies.find(w=>w.id==='gf12');assert.equal(recommend({...base,flavors:target.flavors},[target]).items[0].score,100);
const highball=recommend({...base,serving:'highball'},[target]).items[0];assert.ok(highball.score<100);
const intense=whiskies.find(w=>w.id==='laph');assert.ok(recommend({...base,experience:2},[intense]).items[0].score>recommend({...base,experience:0},[intense]).items[0].score);
console.log('PASS: data integrity, 4 budget bands, flavor ranking, experience and serving weights, deterministic scoring, score bounds, fallback and invalid input.');
