import {whiskies,flavors,servingLabels} from './data.js';
export const WEIGHTS = Object.freeze({flavor:.60,budget:.20,experience:.10,serving:.10});
const bands = [[0,50000],[50000,100000],[100000,200000],[200000,Infinity]];
// 중복 경계 방지: 첫 구간 <=5만, 두 번째 >5만 <=10만, 세 번째 >10만 <20만, 마지막 >=20만.
export function fitsBudget(w,budget){const p=(w.price[0]+w.price[1])/2;return budget===0?p<=50000:budget===1?p>50000&&p<=100000:budget===2?p>100000&&p<200000:p>=200000;}
export function recommend(profile,catalog=whiskies){
 if(![0,1,2].includes(profile.experience)||![0,1,2,3].includes(profile.budget)||!Object.hasOwn(servingLabels,profile.serving)||profile.flavors.length!==5||profile.flavors.some(v=>!Number.isInteger(v)||v<0||v>5))throw new Error('설문 입력을 확인해 주세요.');
 const ranked=catalog.map(w=>{
  const flavor=1-Math.sqrt(w.flavors.reduce((s,v,i)=>s+(v-profile.flavors[i])**2,0)/5)/5;
  const inBudget=fitsBudget(w,profile.budget),mid=(w.price[0]+w.price[1])/2,[lo,hi]=bands[profile.budget];
  const distance=mid<lo?lo-mid:mid>hi?mid-hi:0;
  const budget=inBudget?1:Math.max(0,1-distance/Math.max(lo,Number.isFinite(hi)?hi:lo,50000));
  const experience=profile.experience>=w.level?1:Math.max(0,1-(w.level-profile.experience)*.45);
  const serving=profile.serving==='unknown'?1:w.servings.includes(profile.serving)?1:.25;
  const components={flavor,budget,experience,serving};
  const raw=Object.entries(WEIGHTS).reduce((s,[k,v])=>s+components[k]*v,0);
  const closest=w.flavors.map((v,i)=>({i,d:Math.abs(v-profile.flavors[i])})).sort((a,b)=>a.d-b.d).slice(0,2).map(x=>flavors[x.i]);
  const reasons=[`${closest.join('·')} 강도가 선택한 취향과 잘 어울립니다.`,inBudget?'예상 가격의 중간값이 선택한 예산 구간에 해당합니다.':'선택 예산 구간 밖의 대안입니다. 예상 가격을 확인해 주세요.',profile.experience<w.level?'풍미가 강한 편이라 처음에는 소량으로 천천히 경험해 보세요.':'선택한 경험 수준에서 즐기기 좋은 풍미입니다.',profile.serving==='unknown'?`${servingLabels[w.servings[0]]}로 시작해 보세요.`:w.servings.includes(profile.serving)?`${servingLabels[profile.serving]}에 잘 어울립니다.`:`선택한 방식보다 ${servingLabels[w.servings[0]]}를 권합니다.`];
  return {...w,score:Math.round(raw*100),raw,inBudget,components,reasons};
 });
 // 예산 적합 제품을 먼저 정렬하고, 같은 그룹 안에서 가중 점수 내림차순. 무작위 요소 없음.
 ranked.sort((a,b)=>Number(b.inBudget)-Number(a.inBudget)||b.raw-a.raw||a.id.localeCompare(b.id));
 const count=ranked.filter(w=>w.inBudget).length;
 return {items:ranked.slice(0,3),notice:count>=3?'':count===0?'선택한 예산 구간에 등록된 제품이 없어 다른 가격대의 대안을 보여드립니다.':`선택한 예산 구간에는 ${count}종이 등록되어 있어 TOP 3의 나머지는 다른 가격대의 대안으로 채웠습니다.`};
}
// UI는 이 공급자만 호출합니다. 향후 API 공급자로 교체할 수 있습니다.
